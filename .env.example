NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-a-database-password
DB_NAME=vavh_main
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=15m
SESSION_SECRET=replace-with-a-long-random-session-secret
CORS_ORIGINS=http://localhost:3000
ADMIN_NOTIFICATION_EMAILS=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=VAVH Studio <no-reply@example.com>
JSON_LIMIT=1mb
UPLOAD_STORAGE=local
S3_BUCKET=replace-with-object-storage-bucket
S3_REGION=replace-with-object-storage-region
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=replace-with-object-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-object-storage-secret
