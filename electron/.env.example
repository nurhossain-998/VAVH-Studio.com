# VAVH Studio Electron Configuration

# Port for Express backend server
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-a-database-password
DB_NAME=vavh_main

# Session Configuration
SESSION_SECRET=replace-with-a-long-random-session-secret

# Environment
NODE_ENV=production

# Electron App
ELECTRON_START_URL=http://localhost:3000/admin/index.html
